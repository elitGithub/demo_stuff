<?php

declare(strict_types=1);

header('Cache-Control: no-store');
header('Referrer-Policy: no-referrer');
header('X-Content-Type-Options: nosniff');
header("Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'");
$parts = {{PARTS}};
$code = is_string($_POST['code'] ?? null) ? $_POST['code'] : '';
$authenticated = $_SERVER['REQUEST_METHOD'] === 'POST' && hash_equals('{{CODE_HASH}}', hash('sha256', $code));
$applicationDirectory = __DIR__.'/studio/_app';
$directory = $applicationDirectory.'/.installation';
$completedFile = $directory.'/complete.json';
$message = '';
$ready = false;
$finished = false;
$lock = null;

function studioInstallerEscape(string $value): string
{
    return htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
}

function studioInstallerWrite(string $path, string $contents): void
{
    $temporary = $path.'.'.bin2hex(random_bytes(8)).'.tmp';
    if (file_put_contents($temporary, $contents, LOCK_EX) !== strlen($contents)) {
        if (is_file($temporary)) {
            unlink($temporary);
        }
        throw new RuntimeException('Cannot save installation progress. Check the directory permissions.');
    }
    if (! rename($temporary, $path)) {
        unlink($temporary);
        throw new RuntimeException('Cannot save installation progress. The previous state was preserved.');
    }
}

try {
    if (is_file($completedFile)) {
        throw new RuntimeException('This installation is already complete. Remove install-studio.php if it remains.');
    }
    if ($_SERVER['REQUEST_METHOD'] === 'POST' && ! $authenticated) {
        http_response_code(403);
        throw new RuntimeException('The installation code is incorrect.');
    }
    if ($authenticated) {
        if (PHP_VERSION_ID < 80300) {
            throw new RuntimeException('PHP 8.3 or newer is required.');
        }
        foreach (['ctype', 'dom', 'fileinfo', 'mbstring', 'openssl', 'PDO', 'pdo_sqlite', 'session', 'tokenizer', 'xml', 'gd'] as $extension) {
            if (! extension_loaded($extension)) {
                throw new RuntimeException('Missing PHP extension: '.$extension);
            }
        }
        if (! is_file(__DIR__.'/studio/.htaccess') || ! is_file($applicationDirectory.'/.htaccess')) {
            throw new RuntimeException('The access-protection files are missing. Extract 01-setup.zip into htdocs first.');
        }
        foreach (['.installation', 'bootstrap/cache', 'storage/app/private', 'storage/app/public', 'storage/framework/cache/data', 'storage/framework/sessions', 'storage/framework/views', 'storage/fonts', 'storage/logs'] as $relative) {
            $path = $applicationDirectory.'/'.$relative;
            if (! is_dir($path) && ! @mkdir($path, 0755, true) && ! is_dir($path)) {
                throw new RuntimeException('Cannot create studio/_app/'.$relative.'. Check the uploaded folder and its write access.');
            }
        }
        $lock = @fopen($directory.'/install.lock', 'c');
        if (! $lock) {
            throw new RuntimeException('Cannot write the installation lock file. Check write access to studio/_app/.installation.');
        }
        $wouldBlock = 0;
        if (! flock($lock, LOCK_EX | LOCK_NB, $wouldBlock)) {
            throw new RuntimeException($wouldBlock ? 'Another installation step is running. Wait, then retry.' : 'The server could not acquire a file lock. No installation changes were made.');
        }
        if (is_file($completedFile) || file_exists(__DIR__.'/studio/index.php')) {
            throw new RuntimeException('An active Studio already exists. Nothing was overwritten.');
        }
        foreach (['.env', 'artisan', 'bootstrap/app.php', 'config/database.php', 'database/database.sqlite', 'vendor/autoload.php', 'vendor/composer/autoload_real.php'] as $relative) {
            if (! is_file($applicationDirectory.'/'.$relative)) {
                throw new RuntimeException('Missing extracted file: studio/_app/'.$relative.'. Use Upload & Unzip for both payload ZIPs into htdocs.');
            }
        }
        foreach (['assets/studio.css', 'assets/studio.js', 'assets/salon-hero.jpg'] as $relative) {
            if (! is_file(__DIR__.'/studio/'.$relative)) {
                throw new RuntimeException('Missing extracted file: studio/'.$relative.'. Use Upload & Unzip for both payload ZIPs into htdocs.');
            }
        }
        $action = is_string($_POST['action'] ?? null) ? $_POST['action'] : 'status';
        if (! in_array($action, ['status', 'finish'], true)) {
            throw new RuntimeException('The installer has been updated. Reload this page, enter the same code, and click Finish installation.');
        }
        $ready = true;
        if ($action === 'finish') {
            require $applicationDirectory.'/vendor/autoload.php';
            $app = require $applicationDirectory.'/bootstrap/app.php';
            $app->usePublicPath(__DIR__.'/studio');
            $app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
            if (! $app->environment('production') || config('app.debug') || ! config('studio.demo') || ! config('studio.public_demo') || config('database.default') !== 'sqlite') {
                throw new RuntimeException('Production browse-only configuration verification failed.');
            }
            $database = $app->make('db')->connection()->getPdo();
            if ($database->query('PRAGMA integrity_check')->fetchColumn() !== 'ok' || (int) $database->query('SELECT count(*) FROM users')->fetchColumn() !== 1 || (int) $database->query('SELECT count(*) FROM clients')->fetchColumn() !== 28) {
                throw new RuntimeException('The fictional demonstration database failed verification.');
            }
            $path = __DIR__.'/studio/index.php';
            $contents = base64_decode('{{PUBLIC_INDEX}}', true);
            $file = fopen($path, 'x');
            if (! $file) {
                throw new RuntimeException('The Studio entry file already exists or cannot be written.');
            }
            try {
                $written = fwrite($file, $contents);
                fclose($file);
                if ($written !== strlen($contents)) {
                    throw new RuntimeException('Could not write the Studio entry file.');
                }
                studioInstallerWrite($completedFile, json_encode(['completed_at' => gmdate('c'), 'release' => '{{RELEASE_HASH}}'], JSON_THROW_ON_ERROR));
            } catch (Throwable $error) {
                if (is_resource($file)) {
                    fclose($file);
                }
                unlink($path);
                throw $error;
            }
            $finished = true;
            $message = 'Installed successfully. Your public demo is ready.';
            foreach (['01-setup.zip', ...array_keys($parts)] as $part) {
                if (is_file(__DIR__.'/'.$part) && ! @unlink(__DIR__.'/'.$part)) {
                    $message .= ' Remove '.$part.' in File Manager.';
                }
            }
            if (! @unlink(__FILE__)) {
                $message .= ' Remove install-studio.php in File Manager.';
            }
        } else {
            $message = 'The extracted application files are present. Click Finish installation.';
        }
    }
} catch (Throwable $error) {
    if (http_response_code() < 400) {
        http_response_code(409);
    }
    $message = $error->getMessage();
} finally {
    if (is_resource($lock)) {
        flock($lock, LOCK_UN);
        fclose($lock);
    }
}
?><!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Install Studio</title><style>body{font:16px system-ui;max-width:680px;margin:50px auto;padding:24px;background:#f8f7f5;color:#292827}p{line-height:1.6}button,input{font:inherit;padding:12px;margin:6px 0}button{cursor:pointer}input{width:95%}a{color:inherit}.notice{padding:16px;background:#fff;border:1px solid #ddd}</style><h1>Install Studio</h1>
<?php if ($message !== '') { ?><p class="notice"><?= studioInstallerEscape($message) ?></p><?php } ?>
<?php if ($finished) { ?><p><a href="/studio/">Open salon website</a> · <a href="/studio/login">Open workspace</a></p><p>The demo uses fictional data and browse-only access.</p>
<?php } elseif (! $authenticated) { ?><p>Extract all three ZIPs into htdocs using File Manager, then enter the installation code from START-HERE.txt.</p><form method="post"><label>Installation code<input type="password" name="code" autocomplete="off" required></label><button>Continue</button></form>
<?php } elseif ($ready) { ?><form method="post"><input type="hidden" name="code" value="<?= studioInstallerEscape($code) ?>"><button name="action" value="finish">Finish installation</button></form>
<?php } else { ?><p>Correct the reported upload problem, then reload this page to retry. Existing extracted files can stay in place.</p><?php } ?></html>
