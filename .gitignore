# Shared rules for the demo workspace.
# Keep project-specific runtime/build rules in each project's .gitignore.
# Do not ignore all top-level entries: new demo folders must stay visible to Git.

# Local configuration and credentials (keep distributable examples).
.env
.env.*
!.env.example
!.env.*.example
auth.json
*.key
*.pem

# Installed dependencies.
node_modules/
vendor/

# Local tooling and operating-system files.
.idea/
.vscode/
.phpintel/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Logs, process files and caches.
*.log
*.pid
*.pid.lock
__pycache__/
*.pyc
*.pyo
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache
.eslintcache
*.tsbuildinfo

# Test reports.
coverage/
.nyc_output/
playwright-report/
test-results/
