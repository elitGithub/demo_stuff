Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^private(?:/|$) - [F,L]
<FilesMatch "(?i)(^\.|\.(sqlite|db|sql|zip|log|env)$)">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
