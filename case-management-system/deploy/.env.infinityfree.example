APP_NAME=Casefile
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo-sites.infinityfree.me/casefile
ASSET_URL=https://demo-sites.infinityfree.me/casefile
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_CA
APP_MAINTENANCE_DRIVER=file
CASEFILE_MODE=demo
DB_CONNECTION=sqlite
# Demo middleware chooses a private visitor database; this fallback is unused in demo mode.
# For a separately configured local installation, use a host filesystem absolute path, never a URL.
# Never point a writable fallback connection at the immutable shipped template.
DB_DATABASE=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/casefile
SESSION_COOKIE=casefile_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
LOG_CHANNEL=single
LOG_LEVEL=warning
MAIL_MAILER=log
MAIL_FROM_ADDRESS=notifications@casefile.example
MAIL_FROM_NAME=Casefile
