APP_NAME=Resto-Chef
APP_TIMEZONE=UTC
APP_CURRENCY=USD
DELIVERY_FEE_CENTS=350
# Set to 1 when serving over HTTPS.
SESSION_SECURE=0
# SQLite stores its file in storage/ outside public/ by default.
DB_DRIVER=sqlite
# DB_PATH=/absolute/private/path/demo.sqlite
# For MySQL, create a separate database and restricted application user first.
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=restaurant_demo
# DB_USER=restaurant_app
# DB_PASSWORD=replace-with-a-random-secret
# DB_SSL_CA=/path/to/database-ca.pem
