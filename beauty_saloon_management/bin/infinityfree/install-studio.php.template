<?php if ($message !== '') { ?><p class="notice"><?= studioInstallerEscape($message) ?></p><?php } ?>
<?php if ($finished) { ?><p><a href="/">Open demo collection</a> · <a href="/studio/">Open salon website</a> · <a href="/studio/login">Open workspace</a></p><p>The demo uses fictional data and browse-only access.</p>
<?php } elseif (! $authenticated) { ?><p>Enter the installation code from your private START-HERE.txt file. No files are changed until you submit an installation step.</p><form method="post"><label>Installation code<input type="password" name="code" autocomplete="off" required></label><button>Continue</button></form>
<?php } else { ?><p><?= count($progress) ?> of <?= count($parts) ?> payloads installed. Upload the payload ZIPs as files into htdocs, then use these buttons in order.</p><?php foreach ($parts as $part => $hash) { ?><form method="post"><input type="hidden" name="code" value="<?= studioInstallerEscape($code) ?>"><button name="action" value="<?= studioInstallerEscape($part) ?>" <?= isset($progress[$part]) ? 'disabled' : '' ?>>Install <?= studioInstallerEscape($part) ?></button></form><?php } ?><form method="post"><input type="hidden" name="code" value="<?= studioInstallerEscape($code) ?>"><button name="action" value="finish" <?= $progress !== $parts ? 'disabled' : '' ?>>Finish installation</button></form><?php } ?></html>
