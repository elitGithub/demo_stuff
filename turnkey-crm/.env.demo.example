APP_NAME="Turnkey CRM"
# Use local only while installing/seeding. Set APP_ENV=demo for read-only operation.
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8081
APP_TIMEZONE=Asia/Jerusalem
APP_LOCALE=en
APP_CURRENCY=USD

TURNKEY_DEMO=true
TURNKEY_COMPANY="Turnkey Services"
TURNKEY_COMPANY_EMAIL=hello@turnkey.example
TURNKEY_COMPANY_ADDRESS="Independent services for growing businesses"
TURNKEY_DEMO_PASSWORD="TurnkeyDemo!2026"

# Create this empty database and supply its credentials before installation.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=turnkey_crm_demo
DB_USERNAME=turnkey_crm
DB_PASSWORD=
DB_PREFIX=

LOG_CHANNEL=stack
LOG_LEVEL=warning
CACHE_STORE=file
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_COOKIE=turnkey_demo_session
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@turnkey.example
MAIL_FROM_NAME="Turnkey CRM"

# Do not add external service credentials or schedule inbound email for this demo.
