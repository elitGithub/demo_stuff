Options -Indexes
DirectoryIndex index.php
RewriteEngine On
# Protect application code and configuration even if the nested rule is missed.
RewriteRule ^private(?:/|$) - [F,L,NC]
RewriteRule (^|/)\. - [F,L]
# This package requires HTTPS (included with InfinityFree free subdomains).
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]
RewriteRule ^assets/[a-zA-Z0-9_-]+\.(css|js|jpg|png|svg|webp|woff2)$ - [L]
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [L,QSA]
