APP_NAME="CustomCRM"
# Installation must allow writes. Change to demo after importing the demo data.
APP_ENV=installation
APP_KEY=
APP_DEBUG=false
APP_URL=https://turnkey-demo.is-great.org
APP_TIMEZONE=Asia/Jerusalem
APP_LOCALE=en
APP_CURRENCY=USD

TURNKEY_SHARED_HOSTING=true
# The installer is intentionally unavailable while TURNKEY_DEMO=true.
TURNKEY_DEMO=false
TURNKEY_COMPANY="CustomCRM Services"
TURNKEY_COMPANY_EMAIL=hello@customcrm.example
TURNKEY_COMPANY_ADDRESS="Independent services for growing businesses"
TURNKEY_DEMO_PASSWORD="CustomCRMDemo!2026"

DB_CONNECTION=mysql
DB_HOST=sql206.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_43175351_turnkey
DB_USERNAME=if0_43175351
DB_PASSWORD=
DB_PREFIX=

LOG_CHANNEL=stack
LOG_LEVEL=warning
CACHE_STORE=file
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_COOKIE=turnkey_hosted_demo_session
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@customcrm.example
MAIL_FROM_NAME="CustomCRM"
